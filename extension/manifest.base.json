        "*://*.google.com.mx/maps*",
        "*://*.google.com.ar/maps*",
        "*://*.google.cl/maps*",
        "*://*.google.com.co/maps*",
        "*://*.google.com.pe/maps*",
        "*://*.google.co.jp/maps*",
        "*://*.google.co.kr/maps*",
        "*://*.google.com.tw/maps*",
        "*://*.google.com.hk/maps*",
        "*://*.google.com.sg/maps*",
        "*://*.google.com.my/maps*",
        "*://*.google.co.th/maps*",
        "*://*.google.com.ph/maps*",
        "*://*.google.co.id/maps*",
        "*://*.google.com.vn/maps*",
        "*://*.google.com.pk/maps*",
        "*://*.google.lk/maps*",
        "*://*.google.com.np/maps*",
        "*://*.google.com.sa/maps*",
        "*://*.google.ae/maps*",
        "*://*.google.com.tr/maps*",
        "*://*.google.com.eg/maps*",
        "*://*.google.com.ng/maps*",
        "*://*.google.co.ke/maps*",
        "*://*.google.co.il/maps*"
      ],
      "js": ["api.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": [
        "*://maps.google.com/*",
        "*://*.google.com/*",
        "*://*.google.com.bd/*",
